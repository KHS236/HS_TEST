        <mxCell id="bk7Mao5zLf92-NXpu16E-32" value="&lt;div&gt;&lt;div&gt;&lt;br style=&quot;font-size: 10px; text-align: left;&quot;&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
